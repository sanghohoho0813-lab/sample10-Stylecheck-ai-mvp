# Optional — when set, the analysis layer can be pointed at a real Vision/LLM API.
# Without it the app runs on the built-in Demo Style Analysis Engine.
NEXT_PUBLIC_AI_API_KEY=

# Optional — Supabase persistence (schema: supabase/schema.sql).
# Without it history/favorites are stored in localStorage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
